---
const footerLinks = [
  {
    title: 'Product',
    links: [
      { label: 'Editor', href: '/editor' },
      { label: 'Analytics', href: '/analytics' },
      { label: 'Thesaurus', href: '/thesaurus' },
      { label: 'Dictionary', href: '/dictionary' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Contact Us', href: '/contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms & Conditions', href: '/terms' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
    ],
  },
];
---

<footer class="bg-white dark:bg-black border-t border-neutral-100 dark:border-neutral-800 py-16 text-sm text-neutral-500 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Left Column: Brand details -->
      <div class="lg:col-span-2 space-y-4 text-left">
        <a href="/" class="flex items-center no-underline hover:opacity-85 transition-opacity" aria-label="WordCounter Home">
          <!-- Light mode logo -->
          <img src="/image.png" alt="WordCounter Logo" class="h-8 w-8 object-contain rounded-md dark:hidden block" />
          <!-- Dark mode logo -->
          <img src="/image%20copy.png" alt="WordCounter Logo" class="h-8 w-8 object-contain rounded-md dark:block hidden" />
        </a>
        <p class="max-w-xs text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
          A secure, privacy-first word counter and editor engineered for high-impact drafts, essays, and scripts.
        </p>
        <p class="text-[11px] text-neutral-400 font-mono">
          &copy; {new Date().getFullYear()} WordCounter. All rights reserved.
        </p>
      </div>

      <!-- Links Columns -->
      {
        footerLinks.map((section) => (
          <div class="text-left">
            <h4 class="font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-400 mb-4">{section.title}</h4>
            <ul class="space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white no-underline transition-colors duration-150"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom status row -->
    <div class="mt-16 pt-8 border-t border-neutral-100 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-neutral-500 font-semibold">All systems operational</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://github.com" class="text-neutral-400 hover:text-neutral-900 transition-colors">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
