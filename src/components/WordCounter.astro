---
const stats = [
  { id: 'words', label: 'Words' },
  { id: 'chars', label: 'Characters' },
  { id: 'charsNoSpace', label: 'No Spaces' },
  { id: 'sentences', label: 'Sentences' },
  { id: 'paragraphs', label: 'Paragraphs' },
  { id: 'lines', label: 'Lines' },
  { id: 'readingTime', label: 'Reading Time' },
  { id: 'speakingTime', label: 'Speaking Time' },
];
---

<div id="word-counter" class="w-full">
  <div class="counter-layout">
    <div class="editor-panel">
      <textarea
        id="text-input"
        class="w-full h-full resize-none border-0 bg-transparent p-4 sm:p-6 text-body-md text-ink placeholder:text-mute outline-none"
        placeholder="Start typing or paste your text here…"
        aria-label="Text input for word counting"
        spellcheck="true"
      ></textarea>
    </div>
    <div class="stats-panel">
      <div class="stats-grid">
        {
          stats.map((stat) => (
            <div class="stat-card">
              <span class="stat-value" id={`stat-${stat.id}`}>0</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
      <div class="detail-section">
        <div class="detail-row">
          <span class="detail-label">Unique Words</span>
          <span class="detail-value" id="stat-uniqueWords">0</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Avg. Word Length</span>
          <span class="detail-value" id="stat-avgWordLength">0</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Avg. Sentence</span>
          <span class="detail-value" id="stat-avgSentence">0 words</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Reading Level</span>
          <span class="detail-value" id="stat-readingLevel">N/A</span>
        </div>
      </div>
      <div class="keyword-section" id="keyword-section">
        <h3 class="keyword-title">Keyword Density</h3>
        <div id="keyword-list" class="keyword-list">
          <span class="text-caption text-mute">Start typing to see keywords…</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const textarea = document.getElementById('text-input');
  const statElements = {};

  function init() {
    const ids = [
      'words', 'chars', 'charsNoSpace', 'sentences', 'paragraphs', 'lines',
      'readingTime', 'speakingTime', 'uniqueWords', 'avgWordLength',
      'avgSentence', 'readingLevel'
    ];
    ids.forEach((id) => {
      statElements[id] = document.getElementById(`stat-${id}`);
    });
  }

  function countSyllables(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, '');
    if (!word.length) return 0;
    if (word.length <= 3) return 1;
    let count = 0;
    const vowels = 'aeiouy';
    let prevVowel = false;
    for (let i = 0; i < word.length; i++) {
      const isVowel = vowels.includes(word[i]);
      if (isVowel && !prevVowel) count++;
      prevVowel = isVowel;
    }
    if (word.endsWith('e')) count--;
    if (word.endsWith('le') && word.length > 2 && !'aeiouy'.includes(word[word.length - 3])) count++;
    if (count === 0) count = 1;
    return count;
  }

  function calcFleschKincaid(words, sentences, syllables) {
    if (!words || !sentences) return null;
    const score = 206.835 - 1.015 * (words / sentences) - 84.6 * (syllables / words);
    return Math.max(0, Math.min(100, Math.round(score * 10) / 10));
  }

  function getReadingLevel(score) {
    if (score === null || score === undefined) return 'N/A';
    if (score >= 90) return '5th Grade';
    if (score >= 80) return '6th Grade';
    if (score >= 70) return '7th Grade';
    if (score >= 60) return '8th & 9th Grade';
    if (score >= 50) return '10th to 12th Grade';
    if (score >= 30) return 'College';
    return 'College Graduate';
  }

  function getKeywordDensity(words) {
    if (!words.length) return [];
    const wordCount = {};
    const stopWords = new Set([
      'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for',
      'of', 'by', 'with', 'from', 'as', 'is', 'was', 'are', 'were', 'be',
      'been', 'being', 'have', 'has', 'had', 'do', 'does', 'did', 'will',
      'would', 'could', 'should', 'may', 'might', 'shall', 'can', 'not',
      'no', 'nor', 'so', 'if', 'then', 'than', 'that', 'this', 'these',
      'those', 'it', 'its', 'he', 'she', 'they', 'them', 'their', 'we',
      'you', 'your', 'my', 'me', 'our', 'us', 'all', 'each', 'every',
      'some', 'any', 'both', 'few', 'more', 'most', 'other', 'such', 'what',
      'which', 'who', 'whom', 'when', 'where', 'why', 'how', 'about', 'into',
      'over', 'after', 'before', 'between', 'under', 'above', 'below', 'up',
      'down', 'out', 'off', 'just', 'also', 'very', 'too', 'really', 'here',
      'there', 'much', 'many', 'still', 'well', 'back', 'even', 'because',
      'while', 'since', 'until', 'once', 'upon', 'like', 'through', 'during'
    ]);
    words.forEach((w) => {
      const clean = w.replace(/[^a-zA-Z'-]/g, '').toLowerCase();
      if (clean && clean.length > 1 && !stopWords.has(clean)) {
        wordCount[clean] = (wordCount[clean] || 0) + 1;
      }
    });
    const sorted = Object.entries(wordCount)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10);
    const total = words.length;
    return sorted.map(([word, count]) => ({
      word,
      count,
      density: ((count / total) * 100).toFixed(1),
    }));
  }

  function updateStats() {
    const text = textarea.value;
    const trimmed = text.trim();

    const wordArray = trimmed ? trimmed.split(/\s+/) : [];
    const words = wordArray.length;
    const chars = text.length;
    const charsNoSpace = text.replace(/\s/g, '').length;
    const sentences = trimmed ? (trimmed.match(/[.!?]+/g) || []).length : 0;
    const paragraphs = trimmed ? trimmed.split(/\n\s*\n/).filter((p) => p.trim()).length : 0;
    const lines = trimmed ? trimmed.split('\n').filter((l) => l.trim()).length : 0;

    const uniqueWords = new Set(wordArray.map((w) => w.replace(/[^a-zA-Z'-]/g, '').toLowerCase()).filter(Boolean)).size;
    const totalLetters = charsNoSpace;
    const avgWordLength = words > 0 ? (totalLetters / words).toFixed(1) : '0';
    const avgSentence = sentences > 0 ? Math.round(words / sentences) : 0;
    const readingTime = words > 0 ? Math.ceil(words / 238) : 0;
    const speakingTime = words > 0 ? Math.ceil(words / 183) : 0;

    const totalSyllables = wordArray.reduce((sum, w) => sum + countSyllables(w), 0);
    const fleschScore = calcFleschKincaid(words, sentences || 1, totalSyllables);
    const readingLevel = getReadingLevel(fleschScore);

    statElements.words.textContent = words.toLocaleString();
    statElements.chars.textContent = chars.toLocaleString();
    statElements.charsNoSpace.textContent = charsNoSpace.toLocaleString();
    statElements.sentences.textContent = sentences.toLocaleString();
    statElements.paragraphs.textContent = paragraphs.toLocaleString();
    statElements.lines.textContent = lines.toLocaleString();
    statElements.readingTime.textContent = readingTime > 0 ? `${readingTime} min` : '<1 min';
    statElements.speakingTime.textContent = speakingTime > 0 ? `${speakingTime} min` : '<1 min';
    statElements.uniqueWords.textContent = uniqueWords.toLocaleString();
    statElements.avgWordLength.textContent = avgWordLength;
    statElements.avgSentence.textContent = avgSentence > 0 ? `${avgSentence} words` : '0 words';
    statElements.readingLevel.textContent = readingLevel;

    const keywordData = getKeywordDensity(wordArray);
    const keywordList = document.getElementById('keyword-list');
    if (keywordData.length > 0) {
      const maxCount = keywordData[0].count;
      keywordList.innerHTML = keywordData
        .map(
          (k) => `
            <div class="keyword-item">
              <div class="keyword-bar-wrap">
                <div class="keyword-bar" style="width: ${(k.count / maxCount) * 100}%"></div>
              </div>
              <span class="keyword-word">${k.word}</span>
              <span class="keyword-count">${k.count}x</span>
              <span class="keyword-density">${k.density}%</span>
            </div>
          `
        )
        .join('');
    } else {
      keywordList.innerHTML = '<span class="text-caption text-mute">Start typing to see keywords…</span>';
    }
  }

  init();
  textarea.addEventListener('input', updateStats);
  updateStats();
</script>

<style>
  .counter-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: 12px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-level-3);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .counter-layout {
      grid-template-columns: 1fr 360px;
    }
  }

  .editor-panel {
    min-height: 400px;
    border-right: 1px solid var(--color-hairline);
  }

  .editor-panel textarea {
    min-height: 400px;
    line-height: 1.75;
  }

  .stats-panel {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 8px;
    background: var(--color-canvas-soft);
    border-radius: 8px;
    text-align: center;
  }

  .stat-value {
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: var(--color-mute);
    margin-top: 2px;
  }

  .detail-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 4px;
    border-top: 1px solid var(--color-hairline);
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .detail-label {
    font-size: 13px;
    color: var(--color-body);
  }

  .detail-value {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .keyword-section {
    padding-top: 4px;
    border-top: 1px solid var(--color-hairline);
  }

  .keyword-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-body);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 8px;
  }

  .keyword-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow-y: auto;
  }

  .keyword-item {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .keyword-bar-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  .keyword-bar {
    height: 100%;
    background: var(--color-hairline);
    border-radius: 4px;
    opacity: 0.5;
  }

  .keyword-word {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    z-index: 1;
    flex: 1;
  }

  .keyword-count {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-mute);
    z-index: 1;
  }

  .keyword-density {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-body);
    z-index: 1;
    min-width: 36px;
    text-align: right;
  }
</style>
