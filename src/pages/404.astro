---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 Page Not Found | WordCounter"
  description="The page you are looking for does not exist. Go back to WordCounter home or launch the privacy-first editor."
  showFooter={false}
>
  <div class="min-h-[calc(100vh-56px)] bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800 relative overflow-hidden flex flex-col justify-center items-center px-6 py-12 text-center">
    
    <!-- Fine Dot Grid Pattern Backdrop -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.02] dark:opacity-[0.04]"></div>

    <!-- Premium Vercel-Style Ambient Glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[20%] left-1/2 -translate-x-1/2 h-[350px] w-[500px] rounded-full bg-violet-100/40 dark:bg-violet-950/20 blur-[120px]"></div>
      <div class="absolute bottom-[-100px] right-[20%] h-[400px] w-[400px] rounded-full bg-cyan-100/30 dark:bg-cyan-950/10 blur-[100px]"></div>
    </div>

    <!-- Content Card -->
    <main class="relative max-w-lg w-full z-10 space-y-8">
      
      <!-- 404 Badging -->
      <div class="space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-[11px] font-bold font-mono uppercase tracking-widest bg-rose-50 dark:bg-rose-950/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-900/30 w-fit mx-auto">
          404 Error
        </span>
        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-[-0.05em] text-neutral-900 dark:text-white leading-[1.05]">
          Lost in translation.
        </h1>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 max-w-sm mx-auto leading-relaxed font-light">
          The page or document you are looking for has been moved, cleared from browser cache, or does not exist.
        </p>
      </div>

      <!-- Glassmorphic Informational Callout Box -->
      <div class="panel-card p-6 border border-neutral-200/50 dark:border-neutral-800/80 rounded-xl bg-white/20 dark:bg-neutral-900/20 shadow-[0_4px_30px_rgba(0,0,0,0.01)] backdrop-blur-md text-left space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white flex items-center gap-2">
          <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          Quick Checklist
        </h2>
        <ul class="space-y-1.5 text-xs text-neutral-500 dark:text-neutral-400 leading-normal font-light">
          <li>&bull; Double-check the website address or spelling.</li>
          <li>&bull; Make sure the document wasn't deleted from local storage.</li>
          <li>&bull; Reach out to us if you believe this is a system malfunction.</li>
        </ul>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4">
        <a 
          href="/" 
          class="inline-flex h-11 items-center justify-center rounded-md px-6 py-2 text-xs font-bold text-white dark:text-black bg-neutral-900 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow transition-all duration-150 cursor-pointer"
        >
          Go Back Home
        </a>
        <a 
          href="/editor" 
          class="inline-flex h-11 items-center justify-center rounded-md px-6 py-2 text-xs font-semibold text-neutral-600 dark:text-neutral-300 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-all duration-150 cursor-pointer"
        >
          Launch the Editor
        </a>
      </div>

    </main>
  </div>
</BaseLayout>

<style>
  /* Premium dot-grid utility matching home designs */
  .grid-bg {
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global(html[data-theme="dark"]) .grid-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }
</style>
