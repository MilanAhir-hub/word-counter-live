---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    title: "How to Optimize Your Writing for SEO in 2026",
    excerpt: "Learn the core principles of keyword density, readability scores, and how to structure your content to rank higher on Google without sacrificing human touch.",
    date: "Jan 12, 2026",
    category: "SEO",
    readTime: "5 min read",
    author: "Elena Rodriguez"
  },
  {
    title: "Why Flesch Reading Ease Matters for Conversion",
    excerpt: "Complex writing doesn't make you sound smarter—it hurts your conversion rates. Discover why targeting a standard readability score is the industry standard for copywriters.",
    date: "Feb 04, 2026",
    category: "Copywriting",
    readTime: "4 min read",
    author: "David Chen"
  },
  {
    title: "The Ultimate Guide to Using AI for Drafting",
    excerpt: "AI won't replace writers, but writers who use AI will replace those who don't. A deep dive into using generative intelligence to expand, shorten, and polish your drafts.",
    date: "Mar 18, 2026",
    category: "AI Writing",
    readTime: "7 min read",
    author: "Sarah Jenkins"
  },
  {
    title: "Understanding Word Counts: How Long Should Your Post Be?",
    excerpt: "Does word count still matter? We analyzed top-performing pages to find the sweet spot for modern blogs, high-ranking essays, and viral social media updates.",
    date: "Apr 02, 2026",
    category: "Content Strategy",
    readTime: "6 min read",
    author: "Marcus Wei"
  },
  {
    title: "The Science of Reading & Speaking Time Estimation",
    excerpt: "How are reading and speaking times computed, and why do they increase audience engagement? Explore the psycholinguistics of user tempo and interaction.",
    date: "May 10, 2026",
    category: "Productivity",
    readTime: "5 min read",
    author: "Dr. Clara Mercer"
  },
  {
    title: "Mastering Keyword Density: Rules for Modern Content Creation",
    excerpt: "Is keyword stuffing truly dead? Learn the math behind natural language processing, semantic density, and how to balance keywords for modern search engines.",
    date: "May 24, 2026",
    category: "SEO",
    readTime: "6 min read",
    author: "Elena Rodriguez"
  },
  {
    title: "Generative AI and the Future of Collaborative Editing",
    excerpt: "From static text inputs to Notion-style floating assistant widgets. Discover how AI integrations are reshaping real-time editing workflows for creators.",
    date: "Jun 02, 2026",
    category: "AI Writing",
    readTime: "8 min read",
    author: "Sarah Jenkins"
  },
  {
    title: "Readability as a Ranking Factor: Truth or Myth?",
    excerpt: "Does Google reward simpler writing? Demystifying the relationship between Flesch readability indices, bounce rates, and organic SEO ranking signals.",
    date: "Jun 15, 2026",
    category: "SEO",
    readTime: "5 min read",
    author: "Marcus Wei"
  },
  {
    title: "Write Better Copy: How to Trim Fluff and Enhance Clarity",
    excerpt: "Wordiness is the silent killer of effective copy. Explore practical heuristics and sentence structures to make your messages concise, punchy, and memorable.",
    date: "Jun 28, 2026",
    category: "Copywriting",
    readTime: "4 min read",
    author: "David Chen"
  }
];

const featuredPost = posts[0];
const popularPosts = [posts[2], posts[3], posts[1]];
const categories = ["All", "AI Writing", "SEO", "Copywriting", "Productivity", "Content Strategy"];
---

<BaseLayout 
  title="Editorial Blog | WordCounter"
  description="Curated insights and strategies on modern copywriting, SEO optimization, and leveraging AI tools to write better content."
  showFooter={true}
>
  <div class="min-h-screen bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800">
    
    <!-- Main Editorial Container -->
    <main class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12 lg:py-20">
      
      <!-- Top Section: Categories & Search -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-16 lg:mb-20">
        
        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2">
          {categories.map((cat, i) => (
            <button 
              class={`category-btn px-3 py-1.5 text-[13px] font-medium rounded-full border transition-colors cursor-pointer ${
                i === 0 
                  ? 'bg-black text-white border-black dark:bg-white dark:text-black dark:border-white' 
                  : 'bg-transparent text-neutral-600 dark:text-neutral-400 border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Integrated Search -->
        <div class="relative w-full md:w-64 group">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-neutral-400 group-focus-within:text-neutral-900 dark:group-focus-within:text-white transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="search-input"
            placeholder="Search articles..." 
            class="w-full bg-neutral-50 dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 rounded-md pl-10 pr-3 py-2 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
          />
          <div class="absolute inset-y-0 right-0 pr-2 flex items-center pointer-events-none">
            <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono font-medium text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded border border-neutral-200 dark:border-neutral-700">⌘K</kbd>
          </div>
        </div>
      </div>

      <!-- Featured Article -->
      <section id="featured-section" class="mb-20 lg:mb-28 border-b border-neutral-100 dark:border-neutral-900 pb-16">
        <article class="group cursor-pointer flex flex-col gap-5">
          <div class="flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
            <span class="font-medium text-neutral-900 dark:text-neutral-100">{featuredPost.category}</span>
            <span>&middot;</span>
            <span>{featuredPost.date}</span>
            <span>&middot;</span>
            <span>{featuredPost.readTime}</span>
            <span>&middot;</span>
            <span>By {featuredPost.author}</span>
          </div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-neutral-900 dark:text-white group-hover:opacity-70 transition-opacity duration-200 leading-[1.1]">
            <a href="#" class="focus:outline-none">{featuredPost.title}</a>
          </h2>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 max-w-3xl leading-relaxed mt-2">
            {featuredPost.excerpt}
          </p>
        </article>
      </section>

      <!-- Main Layout Grid -->
      <div class="grid lg:grid-cols-12 gap-16 lg:gap-24 items-start">
        
        <!-- Left Column: Article Feed -->
        <div class="lg:col-span-8 space-y-12">
          <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-900 pb-4 mb-8">
            <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400" id="articles-header">Latest Articles</h3>
          </div>
          
          <div class="space-y-12" id="posts-feed">
            {posts.map(post => (
              <article class="post-card group cursor-pointer flex flex-col gap-3 transition-all duration-200" data-category={post.category} data-search={`${post.title.toLowerCase()} ${post.excerpt.toLowerCase()} ${post.author.toLowerCase()} ${post.category.toLowerCase()}`}>
                <div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400 mb-1">
                  <span class="font-medium text-neutral-900 dark:text-neutral-100">{post.category}</span>
                  <span>&middot;</span>
                  <span>{post.date}</span>
                </div>
                <h4 class="text-xl md:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200">
                  <a href="#" class="focus:outline-none">{post.title}</a>
                </h4>
                <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm md:text-base max-w-2xl">
                  {post.excerpt}
                </p>
                <div class="mt-2 text-xs text-neutral-500 dark:text-neutral-500">
                  <span>{post.readTime}</span>
                  <span class="mx-2">&middot;</span>
                  <span>By {post.author}</span>
                </div>
              </article>
            ))}

            <!-- Clean Empty State when no search results match -->
            <div id="no-results-state" class="hidden py-16 text-center border border-dashed border-neutral-200 dark:border-neutral-800 rounded-xl bg-neutral-50/30 dark:bg-neutral-900/10">
              <svg class="mx-auto h-8 w-8 text-neutral-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">No articles found</h4>
              <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-1">Try expanding your search or selecting a different category.</p>
            </div>
          </div>
          
          <div class="pt-8">
            <button class="text-sm font-medium text-neutral-900 dark:text-white hover:opacity-70 transition-opacity inline-flex items-center">
              View all articles 
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </div>
        </div>

        <!-- Right Column: Popular & Newsletter -->
        <aside class="lg:col-span-4 space-y-16 sticky top-24">
          
          <!-- Popular Articles -->
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-4 mb-8">Popular</h3>
            <div class="space-y-8">
              {popularPosts.map((pop, index) => (
                <article class="group cursor-pointer">
                  <a href="#" class="flex gap-4 items-baseline focus:outline-none">
                    <span class="text-sm font-mono font-medium text-neutral-300 dark:text-neutral-700">0{index + 1}</span>
                    <div>
                      <h4 class="text-sm font-medium leading-snug text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        {pop.title}
                      </h4>
                      <span class="text-xs text-neutral-500 mt-1.5 block">{pop.readTime}</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>


        </aside>

      </div>
    </main>
  </div>
</BaseLayout>

<script>
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const categoryButtons = document.querySelectorAll('.category-btn');
      const postCards = document.querySelectorAll('.post-card');
      const featuredSection = document.getElementById('featured-section');
      const articlesHeader = document.getElementById('articles-header');
      const noResultsState = document.getElementById('no-results-state');

      let activeCategory = 'All';
      let searchQuery = '';

      function updateFilters() {
        let visibleCount = 0;

        postCards.forEach((card, index) => {
          const category = card.getAttribute('data-category');
          const searchText = card.getAttribute('data-search') || '';

          const matchesCategory = activeCategory === 'All' || category === activeCategory;
          const matchesSearch = !searchQuery || searchText.includes(searchQuery.toLowerCase());

          // Deduplication: Hide first post card from the feed when Category is All and Search is empty (since it's featured at the top)
          const isFeaturedDuplicate = index === 0 && activeCategory === 'All' && !searchQuery;

          if (matchesCategory && matchesSearch && !isFeaturedDuplicate) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide/Show Featured banner
        if (activeCategory === 'All' && !searchQuery) {
          featuredSection?.classList.remove('hidden');
          if (articlesHeader) articlesHeader.textContent = 'Latest Articles';
        } else {
          featuredSection?.classList.add('hidden');
          if (articlesHeader) articlesHeader.textContent = `Filtered Results (${visibleCount})`;
        }

        // Show "no results" state if no cards are visible and the featured section is hidden
        if (visibleCount === 0 && (activeCategory !== 'All' || searchQuery)) {
          noResultsState?.classList.remove('hidden');
        } else {
          noResultsState?.classList.add('hidden');
        }
      }

      // Category filter clicks
      categoryButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryButtons.forEach(b => {
            b.className = 'category-btn px-3 py-1.5 text-[13px] font-medium rounded-full border transition-colors bg-transparent text-neutral-600 dark:text-neutral-400 border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 cursor-pointer';
          });
          btn.className = 'category-btn px-3 py-1.5 text-[13px] font-medium rounded-full border transition-colors bg-black text-white border-black dark:bg-white dark:text-black dark:border-white cursor-pointer';
          
          activeCategory = btn.getAttribute('data-category') || 'All';
          updateFilters();
        });
      });

      // Search input input listener
      searchInput?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        searchQuery = target.value.trim();
        updateFilters();
      });

      // Search keyboard shortcuts (⌘K or Ctrl+K or / focus)
      window.addEventListener('keydown', (e) => {
        if (((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') || e.key === '/') {
          if (document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput?.focus();
            searchInput?.select();
          }
        }
      });
      
      // Initialize deduplication
      updateFilters();
    });
  }
</script>
