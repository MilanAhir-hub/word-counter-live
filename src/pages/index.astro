---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero Section with Mesh Gradient -->
  <section class="hero-section relative overflow-hidden pb-24 pt-20 border-b">
    <!-- Fine Grid Pattern Overlay -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.03] dark:opacity-[0.05]"></div>
    
    <!-- Atmospheric Spotlight -->
    <div class="absolute inset-0 spotlight pointer-events-none"></div>

    <!-- Premium Vercel-Style Atmospheric Glow Backdrop -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <!-- Layer 2: Subtle Ambient Gradient -->
      <div class="hero-ambient-glow absolute inset-0"></div>
      <!-- Layer 3: Faint Headline Accent Glow -->
      <div class="hero-headline-accent absolute inset-0"></div>
      <!-- Layer 1: Giant bottom-center glowing half-circle (subconsciously floating) -->
      <div class="hero-bottom-glow"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 text-center z-10">
      <!-- Badge -->
      <div class="hero-badge inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium shadow-[0_1px_2px_rgba(0,0,0,0.02)] backdrop-blur-md transition-all duration-300">
        <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono uppercase tracking-wider text-[10px] font-semibold">✨ Free Forever • No Login Required</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-title mx-auto mt-6 max-w-4xl text-5xl font-semibold tracking-[-0.04em] sm:text-6xl md:text-7xl leading-[1.05] text-balance">
        Write better.<br class="hidden sm:inline" /> Analyze smarter.
      </h1>

      <!-- Description -->
      <p class="hero-description mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-balance">
        Word count, readability, grammar, keyword analysis, and AI writing tools — all in one clean, privacy-first workplace.
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/editor"
          class="btn-primary inline-flex h-11 items-center justify-center rounded-md px-6 text-sm font-medium transition-all duration-150"
        >
          Start Writing
        </a>
        <a
          href="#features"
          class="btn-secondary inline-flex h-11 items-center justify-center rounded-md px-6 text-sm font-medium transition-all duration-150"
        >
          Explore Features
        </a>
      </div>

      <!-- High-Fidelity Interactive Mockup -->
      <div class="mockup-container relative mx-auto mt-16 max-w-5xl rounded-xl border overflow-hidden transition-all duration-300">
        <!-- Mock Window Bar -->
        <div class="mockup-header flex items-center justify-between border-b px-4 py-3">
          <div class="flex items-center gap-1.5">
            <span class="dot-btn bg-red-400/80"></span>
            <span class="dot-btn bg-amber-400/80"></span>
            <span class="dot-btn bg-emerald-400/80"></span>
            <span class="ml-4 font-mono text-xs file-name">draft_essay_final.txt</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="badge-autosave rounded px-2 py-0.5 font-mono text-[10px] font-semibold">AUTOSAVED</span>
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </div>
        </div>

        <!-- Mock Workspace Panel Grid -->
        <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x mockup-grid">
          <!-- Editor Area (Left 2 Columns) -->
          <div class="md:col-span-2 p-6 text-left min-h-[320px] flex flex-col justify-between mockup-editor">
            <div class="font-sans text-sm editor-text leading-relaxed space-y-4">
              <p>Designing a high-conversion SaaS hero section requires a delicate balance of clarity, brand voice, and absolute visual excellence.</p>
              <p>When writers type their drafts, they expect a seamless interface that never gets in the way of their creativity. Real-time statistics should update silently in the background, offering helpful insights like readability scores, tone, and sentence complexity metrics.</p>
              <p>Our goal is to build a beautiful writing companion that guarantees privacy. By running all processing locally inside the browser, your words never touch external servers. It is elegant, secure, and blazing fast.<span class="cursor-blink inline-block w-1.5 h-4 ml-0.5 bg-neutral-900 dark:bg-white align-middle"></span></p>
            </div>
            <div class="mt-8 pt-4 border-t editor-footer flex items-center justify-between text-xs font-mono">
              <span>Lines: 12  •  Paragraphs: 3</span>
              <span>UTF-8  •  English (US)</span>
            </div>
          </div>

          <!-- Analytics Sidebar (Right 1 Column) -->
          <div class="p-6 text-left space-y-6 mockup-sidebar">
            <div>
              <h3 class="font-mono text-[11px] font-bold uppercase tracking-wider sidebar-title mb-3">Live Metrics</h3>
              <div class="grid grid-cols-2 gap-4">
                <div class="metric-card rounded-lg border p-3">
                  <span class="block text-xs font-medium metric-label">Words</span>
                  <span class="mt-1 block text-2xl font-bold font-sans tracking-tight metric-val">108</span>
                </div>
                <div class="metric-card rounded-lg border p-3">
                  <span class="block text-xs font-medium metric-label">Characters</span>
                  <span class="mt-1 block text-2xl font-bold font-sans tracking-tight metric-val">724</span>
                </div>
              </div>
            </div>

            <!-- Readability & Time -->
            <div class="space-y-3 pt-2 border-t sidebar-divider">
              <div class="flex items-center justify-between">
                <span class="text-xs sidebar-text">Readability (Flesch)</span>
                <span class="rounded bg-cyan-50 dark:bg-cyan-950/40 px-2 py-0.5 text-xs font-semibold text-cyan-700 dark:text-cyan-400">76.4 (Easy)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs sidebar-text">Grade Level</span>
                <span class="text-xs font-medium sidebar-val">8th Grade</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs sidebar-text">Reading Time</span>
                <span class="text-xs font-medium sidebar-val">~26 seconds</span>
              </div>
            </div>

            <!-- Keyword Density -->
            <div class="pt-3 border-t sidebar-divider space-y-2.5">
              <h4 class="font-mono text-[10px] font-bold uppercase tracking-wider sidebar-title">Top Keywords</h4>
              <div class="space-y-2">
                <div>
                  <div class="flex justify-between text-xs sidebar-text mb-1">
                    <span class="sidebar-val">writing</span>
                    <span class="font-mono opacity-80">4.2%</span>
                  </div>
                  <div class="h-1.5 w-full rounded-full progress-bg overflow-hidden">
                    <div class="h-full rounded-full progress-bar-active" style="width: 85%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs sidebar-text mb-1">
                    <span class="sidebar-val">privacy</span>
                    <span class="font-mono opacity-80">2.8%</span>
                  </div>
                  <div class="h-1.5 w-full rounded-full progress-bg overflow-hidden">
                    <div class="h-full rounded-full progress-bar-secondary" style="width: 58%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Trust Badges Checkmarks Row -->
      <div class="mt-16 border-t trust-divider pt-10">
        <div class="mx-auto max-w-3xl grid grid-cols-2 sm:grid-cols-4 gap-y-4 gap-x-8 text-center justify-items-center">
          <div class="flex items-center gap-2 text-sm font-medium trust-item">
            <svg class="h-4 w-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Free Forever</span>
          </div>
          <div class="flex items-center gap-2 text-sm font-medium trust-item">
            <svg class="h-4 w-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Auto Save</span>
          </div>
          <div class="flex items-center gap-2 text-sm font-medium trust-item">
            <svg class="h-4 w-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>Privacy First</span>
          </div>
          <div class="flex items-center gap-2 text-sm font-medium trust-item">
            <svg class="h-4 w-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>No Sign Up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="bg-neutral-50/50 py-24 border-t border-neutral-100 relative">
    <!-- Subtle Background Dot pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"></div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 z-10">
      <!-- Section Heading -->
      <div class="mx-auto max-w-3xl text-center mb-16">
        <span class="font-mono uppercase tracking-wider text-[10px] font-bold text-neutral-400 bg-neutral-100/80 px-2.5 py-1 rounded-full">Features Overview</span>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.03em] text-neutral-900 sm:text-4xl">Everything you need to write your best.</h2>
        <p class="mt-4 text-base text-neutral-500">
          Professional utilities and analytics built natively in a fast, privacy-first interface.
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Real-Time Analytics -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 transition-colors duration-300 group-hover:bg-indigo-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <g fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" d="M7 17v-4m5 4V7m5 10v-6"/>
                <path stroke-linejoin="round" d="M2.5 12c0-4.478 0-6.718 1.391-8.109S7.521 2.5 12 2.5c4.478 0 6.718 0 8.109 1.391S21.5 7.521 21.5 12c0 4.478 0 6.718-1.391 8.109S16.479 21.5 12 21.5c-4.478 0-6.718 0-8.109-1.391S2.5 16.479 2.5 12Z"/>
              </g>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">Real-Time Analytics</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Word, character, sentence, and paragraph counts updated instantly as you type.
          </p>
        </div>

        <!-- Feature 2: AI Writing Assistant -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-violet-50 text-violet-600 transition-colors duration-300 group-hover:bg-violet-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <path fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" d="m15 2l.539 2.392a5.39 5.39 0 0 0 4.07 4.07L22 9l-2.392.539a5.39 5.39 0 0 0-4.07 4.07L15 16l-.539-2.392a5.39 5.39 0 0 0-4.07-4.07L8 9l2.392-.539a5.39 5.39 0 0 0 4.07-4.07zM7 12l.385 1.708a3.85 3.85 0 0 0 2.907 2.907L12 17l-1.708.385a3.85 3.85 0 0 0-2.907 2.907L7 22l-.385-1.708a3.85 3.85 0 0 0-2.907-2.907L2 17l1.708-.385a3.85 3.85 0 0 0 2.907-2.907z"/>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">AI Writing Assistant</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Rewrite paragraphs, fix grammar errors, and improve clarity with smart AI actions.
          </p>
        </div>

        <!-- Feature 3: Keyword Density -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 transition-colors duration-300 group-hover:bg-emerald-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m17 17l4 4m-2-10a8 8 0 1 0-16 0a8 8 0 0 0 16 0"/>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">Keyword Density</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Identify overused words and phrases to optimize your writing structure and SEO.
          </p>
        </div>

        <!-- Feature 4: Readability Analysis -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-50 text-cyan-600 transition-colors duration-300 group-hover:bg-cyan-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.333 3c2.46-.003 4.836.887 6.667 2.5V21a10.07 10.07 0 0 0-6.667-2.5c-1.562 0-2.343 0-2.688-.22a1.16 1.16 0 0 1-.424-.425C2 17.51 2 16.895 2 15.663v-9.26c0-1.428 0-2.141.549-2.72c.548-.579 1.11-.609 2.234-.668Q5.056 3 5.333 3m13.334 0A10.07 10.07 0 0 0 12 5.5V21a10.07 10.07 0 0 1 6.667-2.5c1.562 0 2.343 0 2.688-.22c.207-.133.291-.218.424-.425c.221-.345.221-.96.221-2.192v-9.26c0-1.428 0-2.141-.549-2.72s-1.11-.609-2.234-.668Q18.944 3 18.667 3"/>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">Readability Analysis</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Understand how easy your content is to read with automatic Flesch grade scoring.
          </p>
        </div>

        <!-- Feature 5: Built-in Dictionary -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 transition-colors duration-300 group-hover:bg-amber-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                <path d="M15.5 7h-7m3.999 4h-4M20 22H6a2 2 0 0 1-2-2m0 0a2 2 0 0 1 2-2h14V6c0-1.886 0-2.828-.586-3.414S17.886 2 16 2h-6c-2.828 0-4.243 0-5.121.879C4 3.757 4 5.172 4 8z"/>
                <path d="M19.5 18s-1 .763-1 2s1 2 1 2"/>
              </g>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">Built-in Dictionary</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Discover better words instantly with definitions, synonyms, and antonyms to enhance expression.
          </p>
        </div>

        <!-- Feature 6: Writing Goals -->
        <div class="group relative rounded-xl border border-neutral-200/80 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-rose-50 text-rose-600 transition-colors duration-300 group-hover:bg-rose-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5">
                <path d="M15.131 2.5A10 10 0 0 0 12 2C6.477 2 2 6.477 2 12s4.477 10 10 10s10-4.477 10-10a10 10 0 0 0-.458-3"/>
                <path stroke-linejoin="round" d="M17 12a5 5 0 1 1-5-5"/>
                <path d="M19.5 4.5L12 12m7.5-7.5V2m0 2.5H22"/>
              </g>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-neutral-900">Writing Goals</h3>
          <p class="mt-2 text-sm text-neutral-500 leading-relaxed">
            Track your target progress, monitor word counts, and stay highly productive.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Analytics Showcase Section -->
  <section class="bg-white py-24 border-t border-neutral-100 text-neutral-900 relative overflow-hidden">
    <!-- Atmospheric subtle mesh gradient for light theme -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute bottom-[-100px] right-1/4 h-[400px] w-[500px] rounded-full bg-cyan-100/30 blur-[100px]"></div>
      <div class="absolute bottom-[-80px] left-1/4 h-[450px] w-[450px] rounded-full bg-purple-100/30 blur-[110px]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 z-10">
      <!-- Section Heading -->
      <div class="mx-auto max-w-3xl text-center mb-16">
        <span class="font-mono uppercase tracking-wider text-[10px] font-bold text-cyan-600 bg-cyan-50 border border-cyan-200/50 px-3 py-1 rounded-full">Analytics Showcase</span>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.03em] text-neutral-900 sm:text-4xl">Highlight advanced features.</h2>
        <p class="mt-4 text-base text-neutral-500">
          Go beyond basic counting. Access real-time visual insights to elevate your writing style.
        </p>
      </div>

      <!-- Showcase Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1: Keyword Density -->
        <div class="group relative rounded-xl border border-neutral-200/85 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-350 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3">
            <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-50 text-cyan-600 border border-cyan-100/50">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m17 17l4 4m-2-10a8 8 0 1 0-16 0a8 8 0 0 0 16 0"/>
              </svg>
            </div>
            <h3 class="text-base font-semibold text-neutral-900">Keyword Density</h3>
          </div>
          
          <!-- Mockup Visual -->
          <div class="mt-5 rounded-lg bg-neutral-50 border border-neutral-100 p-3.5 space-y-3 font-mono text-[11px] text-neutral-500">
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-neutral-700 font-medium">writing</span>
                <span class="text-cyan-600 font-bold">3.2%</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-neutral-200/60 overflow-hidden">
                <div class="h-full rounded-full bg-cyan-500" style="width: 80%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-neutral-700 font-medium">privacy</span>
                <span class="text-neutral-500">2.1%</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-neutral-200/60 overflow-hidden">
                <div class="h-full rounded-full bg-neutral-400" style="width: 52%"></div>
              </div>
            </div>
          </div>
          
          <p class="mt-4 text-xs text-neutral-500 leading-relaxed">
            Monitor single and multi-word frequencies to optimize content flow and avoid word repetition.
          </p>
        </div>

        <!-- Card 2: Readability Score -->
        <div class="group relative rounded-xl border border-neutral-200/85 bg-white p-6 shadow-[0_2px_4px_rgba(0,0,0,0.01)] transition-all duration-300 hover:-translate-y-1 hover:border-neutral-350 hover:shadow-[0_12px_24px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3">
            <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100/50">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.333 3c2.46-.003 4.836.887 6.667 2.5V21a10.07 10.07 0 0 0-6.667-2.5c-1.562 0-2.343 0-2.688-.22a1.16 1.16 0 0 1-.424-.425C2 17.51 2 16.895 2 15.663v-9.26c0-1.428 0-2.141.549-2.72c.548-.579 1.11-.609 2.234-.668Q5.056 3 5.333 3m13.334 0A10.07 10.07 0 0 0 12 5.5V21a10.07 10.07 0 0 1 6.667-2.5c1.562 0 2.343 0 2.688-.22c.207-.133.291-.218.424-.425c.221-.345.221-.96.221-2.192v-9.26c0-1.428 0-2.141-.549-2.72s-1.11-.609-2.234-.668Q18.944 3 18.667 3"/>
              </svg>
            </div>
            <h3 class="text-base font-semibold text-neutral-900">Readability Score</h3>
          </div>
          
          <!-- Mockup Visual -->
