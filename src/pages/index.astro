  <!-- FAQ Interactive JS -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const faqItems = document.querySelectorAll('.faq-item');
      
      faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const icon = item.querySelector('.faq-icon');
        
        if (trigger && content) {
          trigger.addEventListener('click', () => {
            const isOpen = item.classList.contains('active');
            
            // Close all other FAQs for smooth accordion behavior
            faqItems.forEach(otherItem => {
              if (otherItem !== item && otherItem.classList.contains('active')) {
                otherItem.classList.remove('active');
                const otherContent = otherItem.querySelector('.faq-content');
                const otherIcon = otherItem.querySelector('.faq-icon');
                const otherTrigger = otherItem.querySelector('.faq-trigger');
                
                if (otherContent) (otherContent as HTMLElement).style.maxHeight = '0';
                if (otherIcon) otherIcon.classList.remove('rotate-180');
                if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
                otherItem.classList.remove('border-indigo-500/30', 'bg-indigo-50/5', 'dark:border-indigo-500/20', 'dark:bg-indigo-950/10');
              }
            });
            
            if (isOpen) {
              item.classList.remove('active');
              (content as HTMLElement).style.maxHeight = '0';
              if (icon) icon.classList.remove('rotate-180');
              trigger.setAttribute('aria-expanded', 'false');
              item.classList.remove('border-indigo-500/30', 'bg-indigo-50/5', 'dark:border-indigo-500/20', 'dark:bg-indigo-950/10');
            } else {
              item.classList.add('active');
              (content as HTMLElement).style.maxHeight = (content as HTMLElement).scrollHeight + 'px';
              if (icon) icon.classList.add('rotate-180');
              trigger.setAttribute('aria-expanded', 'true');
              item.classList.add('border-indigo-500/30', 'bg-indigo-50/5', 'dark:border-indigo-500/20', 'dark:bg-indigo-950/10');
            }
          });
        }
      });
    });
  </script>

