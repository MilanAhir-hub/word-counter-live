---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { word } = Astro.params;

// Sanitization
const cleanWord = (word || '').trim().toLowerCase().replace(/[^a-zA-Z-]/g, '');

// Global cache system to maximize performance on SSR Node server
if (!globalThis.dictionaryCache) {
  globalThis.dictionaryCache = new Map();
}
const cache = globalThis.dictionaryCache;

async function fetchWordDetails(targetWord: string) {
  if (!targetWord) return null;
  if (cache.has(targetWord)) {
    return cache.get(targetWord);
  }

  try {
    const response = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${targetWord}`);
    if (response.status === 404) {
      cache.set(targetWord, null);
      return null;
    }
    if (!response.ok) throw new Error("API Network request failed");
    const data = await response.json();
    cache.set(targetWord, data);
    return data;
  } catch (error) {
    console.error(`Error fetching dictionary word '${targetWord}':`, error);
    return null;
  }
}

const apiResponse = await fetchWordDetails(cleanWord);
const hasData = apiResponse && apiResponse.length > 0;

// Morphological variations for Related Words
function getRelatedWords(w: string) {
  const base = w.toLowerCase();
  const suggestions = new Set<string>();
  
  if (base.endsWith('e')) {
    const stem = base.slice(0, -1);
    suggestions.add(base);
    suggestions.add(stem + 'ation');
    suggestions.add(stem + 'ive');
    suggestions.add(stem + 'or');
    suggestions.add(stem + 'ed');
  } else if (base.endsWith('y')) {
    const stem = base.slice(0, -1);
    suggestions.add(base);
    suggestions.add(stem + 'ication');
    suggestions.add(stem + 'ier');
    suggestions.add(stem + 'ied');
  } else {
    suggestions.add(base);
    suggestions.add(base + 'er');
    suggestions.add(base + 'ing');
    suggestions.add(base + 'ment');
    suggestions.add(base + 'ed');
  }
  
  return Array.from(suggestions)
    .filter(item => item !== base)
    .map(item => item.charAt(0).toUpperCase() + item.slice(1))
    .slice(0, 4);
}

// Variables setup
let wordTitle = cleanWord.charAt(0).toUpperCase() + cleanWord.slice(1);
let phoneticText = '';
let audioUrl = '';
let allDefinitions: Array<{ partOfSpeech: string; definition: string; example: string }> = [];
let allSynonyms = new Set<string>();
let allAntonyms = new Set<string>();

if (hasData) {
  const primaryEntry = apiResponse[0];
  wordTitle = primaryEntry.word.charAt(0).toUpperCase() + primaryEntry.word.slice(1);
  phoneticText = primaryEntry.phonetic || primaryEntry.phonetics?.find((p: any) => p.text)?.text || '';
  audioUrl = primaryEntry.phonetics?.find((p: any) => p.audio && p.audio.trim().length > 0)?.audio || '';

  primaryEntry.meanings.forEach((meaning: any) => {
    if (meaning.synonyms) meaning.synonyms.forEach((s: string) => allSynonyms.add(s));
    if (meaning.antonyms) meaning.antonyms.forEach((a: string) => allAntonyms.add(a));

    meaning.definitions.forEach((def: any) => {
      allDefinitions.push({
        partOfSpeech: meaning.partOfSpeech,
        definition: def.definition,
        example: def.example || ''
      });
      if (def.synonyms) def.synonyms.forEach((s: string) => allSynonyms.add(s));
      if (def.antonyms) def.antonyms.forEach((a: string) => allAntonyms.add(a));
    });
  });
}

const synonymsList = Array.from(allSynonyms).slice(0, 12);
const antonymsList = Array.from(allAntonyms).slice(0, 12);
const relatedWords = getRelatedWords(cleanWord);

// SEO details
const dynamicTitle = hasData 
  ? `${wordTitle} Meaning, Definition, Synonyms & Examples | WordCounter`
  : `Word Not Found | WordCounter`;
const dynamicDescription = hasData
  ? `Learn the meaning of ${cleanWord}, its definitions, parts of speech, synonyms, antonyms, pronunciation, and usage examples.`
  : `Free online dictionary to lookup word definitions, audio pronunciations, part of speech, synonyms, antonyms, and usage examples instantly.`;
---

<BaseLayout 
  title={dynamicTitle}
  description={dynamicDescription}
  showFooter={true}
>
  <div class="min-h-screen bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800 relative overflow-hidden py-12">
    
    <!-- Grid dot pattern overlay backdrop -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.02] dark:opacity-[0.04]"></div>

    <!-- Soft ambient glowing spheres -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[-100px] right-[-5%] h-[400px] w-[400px] rounded-full bg-violet-100/40 dark:bg-violet-950/20 blur-[120px]"></div>
      <div class="absolute bottom-[-100px] left-[-5%] h-[450px] w-[450px] rounded-full bg-cyan-100/30 dark:bg-cyan-950/10 blur-[100px]"></div>
    </div>

    <!-- Main Container -->
    <main class="relative max-w-4xl mx-auto px-6 z-10 text-left space-y-12">
      
      <!-- TOP INTERFACE BAR: Search Field -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pb-8 border-b border-neutral-100 dark:border-neutral-900">
        <a href="/dictionary" class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-500 hover:text-neutral-900 dark:hover:text-white no-underline transition-colors cursor-pointer w-fit">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
          Back to Lexicon
        </a>

        <!-- Premium Search Box -->
        <div class="relative w-full sm:w-80 group">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-neutral-400 group-focus-within:text-neutral-900 dark:group-focus-within:text-white transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="dictionary-search-input"
            value={cleanWord}
            placeholder="Search any word..." 
            class="w-full bg-neutral-50 dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 rounded-md pl-9 pr-14 py-2 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
          />
          <div class="absolute inset-y-0 right-0 pr-2 flex items-center gap-1">
            <kbd class="hidden md:inline-block px-1 py-0.5 text-[8px] font-mono font-medium text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded border border-neutral-200 dark:border-neutral-700 pointer-events-none">⌘K</kbd>
            <button 
              id="dictionary-search-btn"
              class="h-6 w-6 rounded bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer"
            >
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- CONDITIONAL RENDER: WORD RENDER vs ERROR STATE -->
      {hasData ? (
        <div class="space-y-12">
          
          <!-- WORD SUMMARY HERO OVERVIEW -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 bg-neutral-50/30 dark:bg-neutral-900/10 p-6 rounded-2xl border border-neutral-200/40 dark:border-neutral-800/80 backdrop-blur-md">
            <div class="space-y-2">
              <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-bold font-mono uppercase tracking-wider bg-violet-50 dark:bg-violet-950/30 text-violet-600 dark:text-violet-400 border border-violet-100 dark:border-violet-800/50 w-fit">
                {apiResponse[0].meanings[0]?.partOfSpeech || 'word'}
              </span>
              <h2 class="text-4xl sm:text-5xl font-extrabold tracking-[-0.04em] text-neutral-900 dark:text-white capitalize leading-none">{wordTitle}</h2>
              {phoneticText && (
                <p class="text-base font-mono font-medium text-neutral-400 dark:text-neutral-500 tracking-wide mt-1.5">{phoneticText}</p>
              )}
            </div>

            <!-- Play Pronunciation Audio Button -->
            <button 
              id="play-audio-btn"
              data-audio={audioUrl}
              data-word={cleanWord}
              class="inline-flex items-center gap-2 rounded-lg px-4 h-10 text-xs font-bold text-white dark:text-black bg-neutral-900 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow transition-all duration-150 cursor-pointer shrink-0"
              title="Play vocal pronunciation"
            >
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
              Play Pronunciation
            </button>
          </div>

          <!-- PRIMARY CONTENT WRAPPER -->
          <div class="grid lg:grid-cols-12 gap-12 items-start">
            
            <!-- Left Side: Definitions & Examples -->
            <div class="lg:col-span-8 space-y-12">
              
              <!-- Definitions section -->
              <section class="space-y-6">
                <div class="border-b border-neutral-100 dark:border-neutral-900 pb-3">
                  <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400">Definitions</h3>
                </div>

                <div class="space-y-5">
                  {allDefinitions.map((def, index) => (
                    <div class="panel-card p-5 border border-neutral-200/50 dark:border-neutral-800/80 rounded-xl bg-white dark:bg-neutral-900/40 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-200 flex gap-4">
                      <!-- Numerator counter -->
                      <span class="text-xs font-mono font-bold text-neutral-300 dark:text-neutral-700 mt-0.5">0{index + 1}</span>
                      <div class="space-y-2">
                        <div class="flex items-center gap-2">
                          <span class="text-[9px] font-bold font-mono uppercase bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 px-1.5 py-0.5 rounded tracking-wide">{def.partOfSpeech}</span>
                        </div>
                        <p class="text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed font-light">{def.definition}</p>
                        {def.example && (
                          <p class="text-xs italic text-neutral-500 dark:text-neutral-500 font-light pl-3 border-l-2 border-neutral-200 dark:border-neutral-800">
                            "{def.example}"
                          </p>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </section>

            </div>

            <!-- Right Side: Synonyms, Antonyms, & Related -->
            <aside class="lg:col-span-4 space-y-10">
              
              <!-- Synonyms pills -->
              {synonymsList.length > 0 && (
                <div class="space-y-4">
                  <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-3 mb-4">Synonyms</h3>
                  <div class="flex flex-wrap gap-1.5">
                    {synonymsList.map(syn => (
                      <button 
                        class="dictionary-pill px-2.5 py-1.5 text-xs font-medium rounded-full border border-neutral-200/50 dark:border-neutral-800/80 bg-neutral-50/20 dark:bg-neutral-900/10 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-850 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer no-underline capitalize"
                        data-word={syn}
                      >
                        {syn}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- Antonyms pills -->
              {antonymsList.length > 0 && (
                <div class="space-y-4">
                  <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-3 mb-4">Antonyms</h3>
                  <div class="flex flex-wrap gap-1.5">
                    {antonymsList.map(ant => (
                      <button 
                        class="dictionary-pill px-2.5 py-1.5 text-xs font-medium rounded-full border border-neutral-200/50 dark:border-neutral-800/80 bg-neutral-50/20 dark:bg-neutral-900/10 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-850 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer no-underline capitalize"
                        data-word={ant}
                      >
                        {ant}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- Related Words -->
              <div class="space-y-4">
                <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-3 mb-4">Related</h3>
                <div class="flex flex-wrap gap-1.5">
                  {relatedWords.map(rel => (
                    <button 
                      class="dictionary-pill px-2.5 py-1.5 text-xs font-medium rounded-full border border-neutral-200/50 dark:border-neutral-800/80 bg-neutral-50/20 dark:bg-neutral-900/10 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-850 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer no-underline"
                      data-word={rel}
                    >
                      {rel}
                    </button>
                  ))}
                </div>
              </div>

            </aside>
          </div>

        </div>
      ) : (
        /* WORD NOT FOUND / ERROR STATE */
        <div class="py-16 text-center border border-dashed border-neutral-200 dark:border-neutral-800 rounded-2xl bg-neutral-50/30 dark:bg-neutral-900/10 max-w-xl mx-auto space-y-6">
          <div class="h-12 w-12 rounded-full bg-rose-50 dark:bg-rose-950/20 flex items-center justify-center text-rose-500 dark:text-rose-400 mx-auto">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          
          <div class="space-y-2 px-6">
            <h2 class="text-xl font-bold text-neutral-900 dark:text-white">Word '{word}' not found</h2>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed font-light">
              We couldn't locate this word in our English lexicon. Try spelling it differently, or checkout some popular words below.
            </p>
          </div>

          <div class="space-y-3 px-6 pt-4 border-t border-neutral-100 dark:border-neutral-900">
            <h3 class="text-[10px] font-bold font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Popular Recommendations</h3>
            <div class="flex flex-wrap justify-center gap-1.5">
              {["create", "success", "developer", "innovation", "productivity"].map(item => (
                <a 
                  href={`/dictionary/${item}`}
                  class="px-2.5 py-1.5 text-xs font-semibold rounded-full border border-neutral-200/50 dark:border-neutral-800/80 bg-neutral-50/20 dark:bg-neutral-900/10 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-850 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer no-underline capitalize"
                >
                  {item}
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

    </main>
  </div>
</BaseLayout>

<script>
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('dictionary-search-input') as HTMLInputElement | null;
      const btn = document.getElementById('dictionary-search-btn');
      const pills = document.querySelectorAll('.dictionary-pill');
      const playBtn = document.getElementById('play-audio-btn');

      // Search navigation
      function triggerSearch(term: string) {
        const sanitized = term.trim().toLowerCase().replace(/[^a-zA-Z-]/g, '');
        if (sanitized) {
          window.location.href = `/dictionary/${sanitized}`;
        }
      }

      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          triggerSearch(input.value);
        }
      });

      btn?.addEventListener('click', () => {
        if (input) triggerSearch(input.value);
      });

      // Pill search triggers
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          const wordToSearch = pill.getAttribute('data-word');
          if (wordToSearch) triggerSearch(wordToSearch);
        });
      });

      // Audio Play with Web Speech fallback
      playBtn?.addEventListener('click', () => {
        const audioUrl = playBtn.getAttribute('data-audio');
        const wordText = playBtn.getAttribute('data-word') || '';

        if (audioUrl) {
          const audio = new Audio(audioUrl);
          audio.play().catch(() => {
            speakFallback(wordText);
          });
        } else {
          speakFallback(wordText);
        }
      });

      function speakFallback(text: string) {
        if ('speechSynthesis' in window && text) {
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.rate = 0.85; // Natural clear slow cadence
          window.speechSynthesis.speak(utterance);
        } else {
          console.warn("Pronunciation voice output not supported by browser.");
        }
      }

      // Shortcut Focus (⌘K or Ctrl+K or /)
      window.addEventListener('keydown', (e) => {
        if (((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') || e.key === '/') {
          if (document.activeElement !== input) {
            e.preventDefault();
            input?.focus();
            input?.select();
          }
        }
      });
    });
  }
</script>

<style>
  /* Premium dot-grid utility matching home designs */
  .grid-bg {
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global(html[data-theme="dark"]) .grid-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }
</style>
