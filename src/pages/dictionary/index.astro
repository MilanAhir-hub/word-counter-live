---
import BaseLayout from '../../layouts/BaseLayout.astro';

const popularSearches = ["create", "success", "developer", "innovation", "productivity"];
---

<BaseLayout 
  title="English Dictionary & Word Meanings | WordCounter"
  description="Free online dictionary to lookup word definitions, audio pronunciations, part of speech, synonyms, antonyms, and usage examples instantly."
  showFooter={true}
>
  <div class="min-h-[calc(100vh-56px)] bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800 relative overflow-hidden flex flex-col justify-center py-16 sm:py-24">
    
    <!-- Dot Grid pattern overlay backdrop -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.02] dark:opacity-[0.04]"></div>

    <!-- Soft ambient glowing spheres -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[10%] left-1/2 -translate-x-1/2 h-[450px] w-[500px] rounded-full bg-violet-100/40 dark:bg-violet-950/20 blur-[130px]"></div>
      <div class="absolute bottom-[-100px] left-[15%] h-[400px] w-[400px] rounded-full bg-cyan-100/30 dark:bg-cyan-950/10 blur-[100px]"></div>
    </div>

    <!-- Main Container -->
    <main class="relative max-w-2xl w-full mx-auto px-6 z-10 text-center space-y-12">
      
      <!-- Badging & Typographic Header -->
      <div class="space-y-4">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-violet-50 dark:bg-violet-950/30 text-violet-600 dark:text-violet-400 border border-violet-100 dark:border-violet-800/50 w-fit mx-auto">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          Lexicon Directory
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.04em] text-neutral-900 dark:text-white leading-[1.1]">
          Search any word.
        </h1>
        <p class="text-sm sm:text-base text-neutral-500 dark:text-neutral-400 max-w-md mx-auto leading-relaxed font-light">
          Unlock instant definitions, phonetics, parts of speech, synonyms, antonyms, and clean usage examples without signups.
        </p>
      </div>

      <!-- Centered Premium Search Bar -->
      <div class="relative max-w-lg w-full mx-auto group">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-neutral-400 group-focus-within:text-neutral-900 dark:group-focus-within:text-white transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        
        <input 
          type="text" 
          id="dictionary-search-input"
          placeholder="Search any word..." 
          class="w-full h-13 bg-white dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 rounded-xl pl-12 pr-16 text-base text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all shadow-[0_4px_20px_rgba(0,0,0,0.01)] focus:shadow-[0_8px_30px_rgba(0,0,0,0.04)]"
          autofocus
        />
        
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center gap-1.5">
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[9px] font-mono font-medium text-neutral-400 bg-neutral-50 dark:bg-neutral-800 rounded border border-neutral-200 dark:border-neutral-700 pointer-events-none">⌘K</kbd>
          <button 
            id="dictionary-search-btn"
            class="h-7 w-7 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer shadow-sm"
            title="Search Lexicon"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>
          </button>
        </div>
      </div>

      <!-- Popular Searched Terms Pills -->
      <div class="space-y-3 pt-2">
        <h3 class="text-[10px] font-bold font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Popular Searches</h3>
        <div class="flex flex-wrap justify-center gap-2">
          {popularSearches.map(term => (
            <a 
              href={`/dictionary/${term}`}
              class="px-3 py-1.5 text-xs font-semibold rounded-full border border-neutral-200/50 dark:border-neutral-800/80 bg-neutral-50/30 dark:bg-neutral-900/20 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-850 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer no-underline capitalize"
            >
              {term}
            </a>
          ))}
        </div>
      </div>

    </main>
  </div>
</BaseLayout>

<script>
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('dictionary-search-input') as HTMLInputElement | null;
      const btn = document.getElementById('dictionary-search-btn');

      function triggerSearch() {
        if (!input) return;
        const term = input.value.trim().toLowerCase().replace(/[^a-zA-Z-]/g, '');
        if (term) {
          window.location.href = `/dictionary/${term}`;
        }
      }

      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          triggerSearch();
        }
      });

      btn?.addEventListener('click', triggerSearch);

      // Focus Shortcut (⌘K or Ctrl+K or /)
      window.addEventListener('keydown', (e) => {
        if (((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') || e.key === '/') {
          if (document.activeElement !== input) {
            e.preventDefault();
            input?.focus();
            input?.select();
          }
        }
      });
    });
  }
</script>

<style>
  /* Premium dot-grid utility matching home designs */
  .grid-bg {
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global(html[data-theme="dark"]) .grid-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }
</style>
