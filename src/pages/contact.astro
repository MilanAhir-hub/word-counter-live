---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | WordCounter"
  description="Have feedback, feature requests, or general inquiries? Get in touch with the WordCounter development team."
  showFooter={true}
>
  <div class="min-h-screen bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800 relative overflow-hidden">
    
    <!-- Dot grid backdrop overlay -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.02] dark:opacity-[0.04]"></div>

    <!-- Soft ambient glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[-100px] left-[10%] h-[400px] w-[400px] rounded-full bg-violet-100/40 dark:bg-violet-950/15 blur-[120px]"></div>
      <div class="absolute bottom-[-100px] right-[10%] h-[500px] w-[500px] rounded-full bg-cyan-100/30 dark:bg-cyan-950/10 blur-[100px]"></div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main Container -->
    <main class="relative max-w-6xl mx-auto px-6 py-16 lg:py-24 z-10 text-left">
      
      <div class="grid lg:grid-cols-12 gap-16 items-start">
        
        <!-- LEFT COLUMN: Contact Details & Info -->
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-4">
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-cyan-50 dark:bg-cyan-950/30 text-cyan-600 dark:text-cyan-400 border border-cyan-100 dark:border-cyan-800/50 w-fit">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              Get In Touch
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-[-0.04em] text-neutral-900 dark:text-white leading-[1.1]">
              We'd love to hear from you.
            </h1>
            <p class="text-base text-neutral-500 dark:text-neutral-400 leading-relaxed font-light">
              Have ideas to improve WordCounter? Found a bug? Or just want to say hi? Reach out using the contact form, and we'll respond within 24 hours.
            </p>
          </div>

          <div class="space-y-6 pt-6 border-t border-neutral-100 dark:border-neutral-900">
            <div class="flex items-start gap-4">
              <div class="h-8 w-8 rounded-lg bg-neutral-50 dark:bg-neutral-900/60 border border-neutral-200/40 dark:border-neutral-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 shrink-0">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h3 class="text-xs font-bold font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">General Support</h3>
                <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200 mt-1">hello@wordcounter.live</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="h-8 w-8 rounded-lg bg-neutral-50 dark:bg-neutral-900/60 border border-neutral-200/40 dark:border-neutral-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 shrink-0">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              </div>
              <div>
                <h3 class="text-xs font-bold font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Open Source & API</h3>
                <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200 mt-1">github.com/wordcounter-live</p>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Contact Form -->
        <div class="lg:col-span-7">
          <div class="panel-card p-6 sm:p-8 border border-neutral-200/50 dark:border-neutral-800/80 rounded-2xl bg-white dark:bg-neutral-900/40 shadow-[0_4px_24px_rgba(0,0,0,0.01)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.2)] backdrop-blur-md">
            
            <form id="contact-form" class="space-y-6">
              <div class="grid sm:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label for="name" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400">Full Name</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name"
                    required
                    placeholder="Elena Rostova"
                    class="w-full bg-neutral-50 dark:bg-black border border-neutral-200 dark:border-neutral-800 rounded-md px-3.5 py-2.5 text-sm text-neutral-900 dark:text-white placeholder:text-neutral-400 outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
                  />
                </div>
                <div class="space-y-2">
                  <label for="email" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400">Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email"
                    required
                    placeholder="elena@example.com"
                    class="w-full bg-neutral-50 dark:bg-black border border-neutral-200 dark:border-neutral-800 rounded-md px-3.5 py-2.5 text-sm text-neutral-900 dark:text-white placeholder:text-neutral-400 outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label for="subject" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400">Subject</label>
                <input 
                  type="text" 
                  id="subject" 
                  name="subject"
                  required
                  placeholder="Feedback on Flesch readability metric..."
                  class="w-full bg-neutral-50 dark:bg-black border border-neutral-200 dark:border-neutral-800 rounded-md px-3.5 py-2.5 text-sm text-neutral-900 dark:text-white placeholder:text-neutral-400 outline-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
                />
              </div>

              <div class="space-y-2">
                <label for="message" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400">Message</label>
                <textarea 
                  id="message" 
                  name="message"
                  required
                  rows="5"
                  placeholder="Start writing your thoughts here..."
                  class="w-full bg-neutral-50 dark:bg-black border border-neutral-200 dark:border-neutral-800 rounded-md px-3.5 py-2.5 text-sm text-neutral-900 dark:text-white placeholder:text-neutral-400 outline-none resize-none focus:ring-1 focus:ring-black dark:focus:ring-white transition-all"
                ></textarea>
              </div>

              <button 
                type="submit" 
                id="btn-submit"
                class="w-full h-11 inline-flex items-center justify-center rounded-md text-sm font-bold text-white dark:text-black bg-neutral-900 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow transition-all cursor-pointer"
              >
                Send Message
              </button>
            </form>

          </div>
        </div>

      </div>

    </main>
  </div>
</BaseLayout>

<script>
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
      const toastContainer = document.getElementById('toast-container');

      function showToast(message: string, type: 'success' | 'error' = 'success') {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        const icon = type === 'success' ? '✓' : '!';
        const colorClass = type === 'success' 
          ? 'bg-emerald-50 text-emerald-800 border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-400 dark:border-emerald-800' 
          : 'bg-red-50 text-red-800 border-red-200 dark:bg-red-900/20 dark:text-red-400 dark:border-red-800';
        
        toast.className = `flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold border rounded-full shadow-lg pointer-events-auto toast-enter ${colorClass}`;
        toast.innerHTML = `<span class="flex items-center justify-center font-bold text-xs h-4 w-4 bg-white/40 dark:bg-black/20 rounded-full">${icon}</span> <span>${message}</span>`;
        
        toastContainer.appendChild(toast);
        
        setTimeout(() => {
          toast.classList.replace('toast-enter', 'toast-exit');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        
        if (!btnSubmit) return;
        
        // Disable state & loading display
        btnSubmit.disabled = true;
        const originalText = btnSubmit.textContent || 'Send Message';
        btnSubmit.innerHTML = `<span class="animate-spin mr-2">&#9696;</span> Sending...`;
        btnSubmit.style.opacity = '0.7';

        // Simulate high-fidelity network sending delay (1 second)
        setTimeout(() => {
          showToast('Message sent! Our team will get back to you shortly.');
          form.reset();
          
          btnSubmit.disabled = false;
          btnSubmit.textContent = originalText;
          btnSubmit.style.opacity = '1';
        }, 1200);
      });
    });
  }
</script>

<style>
  /* Premium dot-grid utility matching home designs */
  .grid-bg {
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global(html[data-theme="dark"]) .grid-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }

  /* Toast notification enter/exit animations */
  .toast-enter {
    animation: toastSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .toast-exit {
    animation: toastFadeOut 0.3s ease-in forwards;
  }
  @keyframes toastSlideIn {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes toastFadeOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-10px); }
  }
</style>
