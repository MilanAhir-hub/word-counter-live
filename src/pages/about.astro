---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About Us | WordCounter"
  description="Discover the mission of WordCounter—a secure, privacy-first, and highly productive writing companion for modern creators."
  showFooter={true}
>
  <div class="min-h-screen bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-neutral-200 dark:selection:bg-neutral-800 relative overflow-hidden">
    
    <!-- Dot grid backdrop overlay -->
    <div class="absolute inset-0 grid-bg pointer-events-none opacity-[0.02] dark:opacity-[0.04]"></div>

    <!-- Soft ambient glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-[-100px] right-[-100px] h-[400px] w-[400px] rounded-full bg-violet-100/40 dark:bg-violet-950/20 blur-[100px]"></div>
      <div class="absolute bottom-[-100px] left-[-100px] h-[500px] w-[500px] rounded-full bg-cyan-100/30 dark:bg-cyan-950/10 blur-[120px]"></div>
    </div>

    <!-- Main Container -->
    <main class="relative max-w-4xl mx-auto px-6 py-16 lg:py-24 z-10 text-left">
      
      <!-- Page Badge & Hero Header -->
      <header class="space-y-4 mb-16">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-violet-50 dark:bg-violet-950/30 text-violet-600 dark:text-violet-400 border border-violet-100 dark:border-violet-800/50 w-fit">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2".5 d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Our Story
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.04em] text-neutral-900 dark:text-white leading-[1.1]">
          We build tools for the future of writing.
        </h1>
        <p class="text-lg sm:text-xl text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-2xl font-light">
          WordCounter was created to address a simple question: Why must rich formatting, detailed analytics, and powerful AI features compromise your privacy?
        </p>
      </header>

      <!-- Main Narrative Section -->
      <section class="space-y-12">
        <div class="prose dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-300 leading-relaxed space-y-6">
          <p class="text-base">
            Modern content editing tools often require mandatory user accounts, persistent cloud syncs, and background processing servers that analyze every sentence you type. We believed there was a better way—a browser-native, lightning-fast suite that respects the sacred relationship between a writer and their blank page.
          </p>
          <p class="text-base">
            By executing all processing, word calculations, Flesch readability indices, and auto-saves locally inside your browser, your drafts never touch external servers. It is elegant, extremely secure, and blazing fast.
          </p>
        </div>

        <!-- The Three Pillars Grid -->
        <div class="grid sm:grid-cols-3 gap-6 pt-8">
          <div class="panel-card p-6 border border-neutral-200/50 dark:border-neutral-800/80 rounded-xl bg-neutral-50/20 dark:bg-neutral-900/10 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300">
            <div class="h-8 w-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-800/40 mb-4">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="text-base font-bold text-neutral-900 dark:text-white mb-2">Absolute Privacy</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed font-light">
              Your words never leave your device. All analytics, keyword analyses, and saves run locally inside your browser session.
            </p>
          </div>

          <div class="panel-card p-6 border border-neutral-200/50 dark:border-neutral-800/80 rounded-xl bg-neutral-50/20 dark:bg-neutral-900/10 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300">
            <div class="h-8 w-8 rounded-lg bg-violet-50 dark:bg-violet-950/30 flex items-center justify-center text-violet-600 dark:text-violet-400 border border-violet-100 dark:border-violet-800/40 mb-4">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-base font-bold text-neutral-900 dark:text-white mb-2">AI-Driven</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed font-light">
              Leverage custom inline Google Gemini assistants to rewrite, polish, expand, or summarize text blocks directly within your workspace.
            </p>
          </div>

          <div class="panel-card p-6 border border-neutral-200/50 dark:border-neutral-800/80 rounded-xl bg-neutral-50/20 dark:bg-neutral-900/10 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300">
            <div class="h-8 w-8 rounded-lg bg-cyan-50 dark:bg-cyan-950/30 flex items-center justify-center text-cyan-600 dark:text-cyan-400 border border-cyan-100 dark:border-cyan-800/40 mb-4">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-base font-bold text-neutral-900 dark:text-white mb-2">No Friction</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed font-light">
              No logins, no paywalls, no popups. Bookmark the link, open the editor, and begin writing instantly with full automatic draft saving.
            </p>
          </div>
        </div>

        <!-- The Vision CTA -->
        <div class="mt-16 pt-12 border-t border-neutral-100 dark:border-neutral-900 flex flex-col items-center gap-6 text-center">
          <h4 class="text-lg font-bold text-neutral-900 dark:text-white">Ready to begin writing better?</h4>
          <a
            href="/editor"
            class="inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-bold text-white dark:text-black bg-neutral-900 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow transition-all"
          >
            Launch the Editor
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<style>
  /* Premium dot-grid utility matching home designs */
  .grid-bg {
    background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
    background-size: 24px 24px;
  }
  :global(html[data-theme="dark"]) .grid-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }
</style>
